{
  "name": "jp-n5-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client/create.ts src/client/room.ts --bundle --format=esm --target=es2022 --minify --outdir=public/js",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json",
    "start": "node dist/server/index.js",
    "dev": "npm run build:client -- --watch=forever & tsx watch src/server/index.ts",
    "audio": "tsx src/tools/generate-audio.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
